# GitHub Actions Secrets for local act testing
# Rename this file to .secrets and replace the placeholders with your actual tokens

GITHUB_TOKEN=your_github_token_here
NODE_AUTH_TOKEN=your_npm_or_github_token_here
NPM_TOKEN=your_npm_or_github_token_here

# CARTO API Key
CARTO_API_KEY=your_carto_api_key_here
