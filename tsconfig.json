{
    "compilerOptions": {
        "module": "ES2022",
        "target": "ES2022",
        "lib": ["ES2022", "dom"],
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "outDir": "dist/",
        "allowJs": true,
        "checkJs": false,
        "paths": {
            "@ingress-shards/ingress-events-core": [
                "../ingress-events-core/dist/index.d.mts",
                "./node_modules/@ingress-shards/ingress-events-core/dist/index.d.mts"
            ],
            "@ingress-shards/ingress-events-core/*": [
                "../ingress-events-core/dist/*",
                "./node_modules/@ingress-shards/ingress-events-core/dist/*"
            ]
        }
    },
    "include": ["src/**/*", "scripts/**/*"]
}
