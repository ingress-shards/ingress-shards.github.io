{
    "name": "@ingress-shards/ingress-shards-map",
    "version": "0.0.0-semantically-released",
    "description": "Interactive map of shard data from Ingress events",
    "author": {
        "name": "Nick Young"
    },
    "contributors": [
        "Lewis Keen"
    ],
    "license": "MIT",
    "homepage": "https://ingress-shards.github.io/",
    "repository": {
        "type": "git",
        "url": "https://github.com/ingress-shards/ingress-shards.github.io.git"
    },
    "bugs": {
        "url": "https://github.com/ingress-shards/ingress-shards.github.io/issues"
    },
    "type": "module",
    "private": true,
    "main": "dist/main.bundle.js",
    "scripts": {
        "clean": "node -e \"const fs = require('fs'); ['gen', 'dist'].forEach(p => fs.rmSync(p, { recursive: true, force: true }))\"",
        "start": "npm run prepare:data && webpack serve --config webpack.dev.js",
        "build": "npm run prepare:data && webpack --config webpack.prod.js",
        "geocode": "python scripts/geocode.py",
        "data:process": "node scripts/pre-processor-loader.js",
        "data:validate": "node scripts/validator-loader.js",
        "data:statistics": "node scripts/statistics-loader.js",
        "mkdir:gen": "node -e \"if (!require('fs').existsSync('gen')) require('fs').mkdirSync('gen', { recursive: true })\"",
        "prepare:data": "npm run mkdir:gen && npm run geocode && npm run data:process && npm run data:validate && npm run data:statistics",
        "validate": "npm run clean && npm run build",
        "preview": "node scripts/preview-ci-artifact.js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.0.1",
        "@semantic-release/exec": "^7.1.0",
        "conventional-changelog-conventionalcommits": "^10.2.1",
        "css-loader": "^7.1.4",
        "eslint": "^10.8.0",
        "globals": "^16.5.0",
        "html-webpack-plugin": "^5.6.8",
        "semantic-release": "^25.0.9",
        "semantic-release-export-data": "^1.2.0",
        "style-loader": "^4.0.0",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2",
        "webpack-dev-server": "^6.0.0",
        "webpack-merge": "^6.0.1"
    },
    "dependencies": {
        "copy-webpack-plugin": "^14.0.0",
        "flag-icon-css": "^4.1.7",
        "github-fork-ribbon-css": "^0.2.3",
        "leaflet": "^1.9.4",
        "leaflet-providers": "^3.0.0",
        "leaflet-relief": "^1.5.2",
        "leaflet.motion": "github:neon-ninja/leaflet.motion",
        "temporal-polyfill": "^1.0.2"
    }
}
